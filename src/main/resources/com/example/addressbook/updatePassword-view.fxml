<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane minHeight="400" minWidth="350" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.addressbook.controller.UpdatePasswordController">
    <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #2a2d3e;" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>
        <HBox alignment="TOP_LEFT">
            <Button fx:id="backButton" alignment="TOP_LEFT" onAction="#onBackToDetails" style="-fx-background-color:             #6a5acd; -fx-text-fill: white" text="Back">
                <font>
                    <Font name="HelveticaRounded-Bold" size="16.0" />
                </font>
            </Button>
        </HBox>
        <!-- logo -->
        <ImageView>
            <Image requestedHeight="200" requestedWidth="200" url="@../../../Images/logo kinda purple.jpeg" />
        </ImageView>
        <Label text="Update Your Password" textFill="SLATEBLUE" wrapText="true">
            <font>
                <Font name="HelveticaRounded-Bold" size="26.0" />
            </font>
        </Label>

        <VBox spacing="5.0">
            <Label text="Current Password:" textFill="WHITE">
            <font>
               <Font name="HelveticaRounded-Bold" size="16.0" />
            </font></Label>
            <PasswordField fx:id="oldPassword" style="-fx-border-color: #6a5acd;" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="New Password:" textFill="WHITE">
            <font>
               <Font name="HelveticaRounded-Bold" size="16.0" />
            </font></Label>
            <PasswordField fx:id="newPassword" promptText="Enter your new password here" style="-fx-border-color: #6a5acd;" />
        </VBox>

        <Button fx:id="updatePWordConfirm" prefWidth="350" onAction="#onUpdatePassword" style="-fx-background-color: #6a5acd; -fx-text-fill: white; -fx-font-weight: bold;" text="Confirm Update">
         <font>
            <Font name="HelveticaRounded-Bold" size="16.0" />
         </font></Button>
    </VBox>
</StackPane>
