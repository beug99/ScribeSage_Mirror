<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.example.addressbook.controller.UpdatePasswordController">
    <VBox alignment="CENTER" spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">

        <Label text="Update Your Password" textFill="#0099ff">
            <font>
                <Font name="Arial Bold" size="20" />
            </font>
        </Label>

        <VBox spacing="5.0">
            <Label text="Current Password:" />
            <PasswordField fx:id="oldPassword" />
        </VBox>

        <VBox spacing="5.0">
            <Label text="New Password:" textFill="#0099ff" />
            <PasswordField fx:id="newPassword" />
        </VBox>

        <Button fx:id="updatePWordConfirm" onAction="#onUpdatePassword" prefWidth="200" style="-fx-background-color: #0099ff;         -fx-text-fill: white; -fx-font-weight: bold;" text="Confirm Update">
        </Button>
    </VBox>
</AnchorPane>
