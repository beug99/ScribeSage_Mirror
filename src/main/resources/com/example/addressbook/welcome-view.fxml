<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.addressbook.controller.WelcomeController">

    <Label text="Welcome to ScribeSage!"
           wrapText="true"/>

    <Button text="Log in"
            onAction="#onLogIn"
            fx:id="logIn"
    />
    <Button text="Sign up"
            onAction="#onSignUp"
            fx:id="signUp"
    />
</VBox>