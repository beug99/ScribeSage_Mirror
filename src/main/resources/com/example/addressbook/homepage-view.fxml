<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane minHeight="400" minWidth="250" style="-fx-background-color:white;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.addressbook.controller.HomePageController">

    <VBox spacing="10.0"
          AnchorPane.leftAnchor="20.0"
          AnchorPane.rightAnchor="20.0"
          AnchorPane.topAnchor="20.0"
          AnchorPane.bottomAnchor="20.0">
        <padding>
            <Insets bottom="20" left="20" right="20" top="20"/>
        </padding>

        <!-- Profile section top left -->
        <HBox fx:id="profileBar" onMouseClicked="#toggleNavMenu" maxWidth="100">
            <ImageView>
                <Image requestedHeight="50" requestedWidth="50" url="@../../../Images/Logo.png"/>
            </ImageView>
            <Label fx:id="nameLabel" text="First and last name">
                <font>
                    <Font name="Helvetica Bold" size="16.0"/>
                </font>
            </Label>
        </HBox>

        <!-- Notes and Folders Container -->
        <HBox alignment="CENTER" spacing="20.0">
            <!-- Notes Section -->
            <VBox alignment="TOP_CENTER" spacing="10.0">
                <Label style="-fx-font-weight: bold;" text="Notes"/>
                <ListView fx:id="notesListView" prefHeight="300.0" prefWidth="350.0"
                          style="-fx-border-color: #6a5acd;"/>
            </VBox>

            <!-- Folders Section -->
            <VBox alignment="TOP_CENTER" spacing="10.0">
                <Label style="-fx-font-weight: bold;" text="Folders"/>
                <TreeView fx:id="folderTreeView" prefHeight="300.0" prefWidth="350.0"
                          style="-fx-border-color: #6a5acd;"/>
            </VBox>
        </HBox>

        <!-- Buttons for Notes and Folders -->
        <HBox alignment="CENTER" spacing="20.0">
            <Button fx:id="deleteNoteButton" onAction="#onDeleteNote" prefWidth="120.0"
                    style="-fx-background-color: #6a5acd; -fx-text-fill: white; -fx-font-weight: bold;"
                    text="Delete Selected"/>
            <Button fx:id="createNewButton" onAction="#onCreateNew" prefWidth="120.0"
                    style="-fx-background-color: #6a5acd; -fx-text-fill: white; -fx-font-weight: bold;"
                    text="Create New"/>
            <Button fx:id="loadNoteButton" onAction="#onLoadNote" prefWidth="120.0"
                    style="-fx-background-color: #6a5acd; -fx-text-fill: white; -fx-font-weight: bold;"
                    text="Load Selected"/>
            <Button fx:id="createFolderButton" onAction="#onCreateFolder" prefWidth="120.0"
                    style="-fx-background-color: #6a5acd; -fx-text-fill: white; -fx-font-weight: bold;"
                    text="Create Folder"/>
        </HBox>
    </VBox>

    <!-- Nav menu as an overlay positioned at the top left -->
    <AnchorPane pickOnBounds="false" mouseTransparent="false">
        <VBox fx:id="navMenu" style="-fx-background-color: white; -fx-border-color: lightgray; -fx-effect: dropshadow(gaussian, lightgray, 8, 0, 2, 2);"
              visible="false" maxWidth="180" AnchorPane.leftAnchor="20" AnchorPane.topAnchor="70">
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="nav-item">
                <padding>
                    <Insets bottom="5" left="10" right="10" top="5"/>
                </padding>
                <ImageView fitHeight="32.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../../Images/Update%20Details%20purple.png"/>
                    </image>
                </ImageView>
                <Label fx:id="updateDetailsLabel" onMouseClicked="#onUpdateDetails" style="-fx-cursor: hand;"
                       text="Update Details">
                    <font>
                        <Font name="System Bold" size="12.0"/>
                    </font>
                </Label>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="nav-item">
                <padding>
                    <Insets bottom="5" left="10" right="10" top="5"/>
                </padding>
                <ImageView fitHeight="28.0" fitWidth="33.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../../Images/Settings%20purple.png"/>
                    </image>
                </ImageView>
                <Label prefHeight="18.0" prefWidth="80.0" text="Settings">
                    <font>
                        <Font name="System Bold" size="12.0"/>
                    </font>
                </Label>
            </HBox>
            <HBox alignment="CENTER_LEFT" onMouseClicked="#onLogOut" spacing="10.0" styleClass="nav-item">
                <padding>
                    <Insets bottom="5" left="10" right="10" top="5"/>
                </padding>
                <ImageView fitHeight="31.0" fitWidth="34.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../../Images/Log%20out%20purple.png"/>
                    </image>
                </ImageView>
                <Label prefHeight="18.0" prefWidth="80.0" text="Logout">
                    <font>
                        <Font name="System Bold" size="12.0"/>
                    </font>
                </Label>
            </HBox>
        </VBox>
    </AnchorPane>
</StackPane>