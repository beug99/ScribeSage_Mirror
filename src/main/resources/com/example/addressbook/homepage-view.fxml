<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: #2a2d3e;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.addressbook.controller.HomePageController">

    <VBox spacing="10.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>

        <!-- Profile section top left -->
        <HBox fx:id="profileBar" alignment="CENTER_LEFT" maxWidth="-Infinity" minWidth="-Infinity" onMouseClicked="#toggleNavMenu" prefWidth="-Infinity" spacing="10" style="-fx-cursor: hand;">
            <ImageView>
                <Image requestedHeight="50" requestedWidth="50" url="@../../../Images/logo kinda purple.jpeg" />
            </ImageView>
            <Label fx:id="nameLabel" minWidth="-Infinity" style="-fx-font-weight: bold;" text="First and last name" textFill="WHITE">
                <font>
                    <Font name="HelveticaRounded-Bold" size="16.0" />
                </font>
            </Label>
        </HBox>

        <VBox fx:id="mainLayout" alignment="TOP_CENTER" prefHeight="400.0" prefWidth="900.0" spacing="20.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="120.0">
            <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Your Content:" textFill="WHITE">
                <font>
                    <Font name="HelveticaRounded-Bold" size="23.0" />
                </font></Label>

            <!-- Search Bar -->
            <HBox alignment="CENTER" spacing="10.0">
                <TextField fx:id="searchField" prefWidth="400.0" promptText="Search notes..." />
                <Button onAction="#onSearchNote" style="-fx-background-color: #6a5acd; -fx-text-fill: white; -fx-font-weight: bold;" text="Search" textFill="WHITE" />
            </HBox>

            <!-- Notes and Folders Tree View -->
            <VBox alignment="TOP_CENTER" spacing="10.0" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Button fx:id="sortButton" onAction="#onSortAlphabetically" style="-fx-background-color: #6a5acd;" text="Sort Alphabetically" textFill="WHITE">
                  <font>
                     <Font name="HelveticaRounded-Bold" size="12.0" />
                  </font></Button>
                    <Button fx:id="sortDateButton" onAction="#onSortByDate" style="-fx-background-color: #6a5acd;" text="Sort By Date" textFill="WHITE">
                        <font>
                            <Font name="HelveticaRounded-Bold" size="12.0" />
                        </font>
                    </Button>
                </HBox>
                <TreeView fx:id="notesTreeView" prefHeight="300.0" prefWidth="700.0" style="-fx-border-color: #6a5acd; -fx-border-width: 2; -fx-font-family: helvetica rounded; -fx-font-size: 14px;">
                </TreeView>
            </VBox>

            <!-- Buttons for Notes and Folders -->
            <HBox alignment="CENTER" spacing="20.0">
                <Button fx:id="deleteNoteButton" onAction="#onDeleteItem" prefWidth="120.0" style="-fx-background-color: #6a5acd; -fx-text-fill: white; -fx-font-weight: bold;" text="Delete" />
                <Button fx:id="createNewButton" onAction="#onCreateNew" prefWidth="120.0" style="-fx-background-color: #6a5acd; -fx-text-fill: white; -fx-font-weight: bold;" text="New Note" />
                <Button fx:id="loadNoteButton" onAction="#onLoadNote" prefWidth="120.0" style="-fx-background-color: #6a5acd; -fx-text-fill: white; -fx-font-weight: bold;" text="Open Note" />
                <Button fx:id="createFolderButton" onAction="#onCreateFolder" prefWidth="120.0" style="-fx-background-color: #6a5acd; -fx-text-fill: white; -fx-font-weight: bold;" text="New Folder" />
            </HBox>
        </VBox>
    </VBox>
    <!-- Nav menu as an overlay positioned at the top left -->
    <AnchorPane mouseTransparent="false" pickOnBounds="false">
        <VBox fx:id="navMenu" maxWidth="180" style="-fx-background-color: #2a2d3e; -fx-border-width: 2; -fx-border-color: white; -fx-border-radius: 2;" visible="false" AnchorPane.leftAnchor="20" AnchorPane.topAnchor="70">
            <HBox alignment="CENTER_LEFT" onMouseClicked="#onUpdateDetails" spacing="10.0" styleClass="nav-item">
                <padding>
                    <Insets bottom="5" left="10" right="10" top="5" />
                </padding>
                <ImageView fitHeight="32.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
                    <image>
                        <Image url="@../../../Images/Update%20Details%20purple.png" />
                    </image>
                </ImageView>
                <Label fx:id="updateDetailsLabel" style="-fx-cursor: hand; -fx-font-weight: bold;" text="Update Details" textFill="WHITE">
                    <font>
                        <Font name="HelveticaRounded-Bold" size="12.0" />
                    </font>
                </Label>
            </HBox>
            <HBox alignment="CENTER_LEFT" onMouseClicked="#onLogOut" spacing="10.0" styleClass="nav-item">
                <padding>
                    <Insets bottom="5" left="10" right="10" top="5" />
                </padding>
                <ImageView fitHeight="31.0" fitWidth="34.0" pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;">
                    <image>
                        <Image url="@../../../Images/Log%20out%20purple.png" />
                    </image>
                </ImageView>
                <Label prefHeight="18.0" prefWidth="80.0" style="-fx-cursor: hand; -fx-font-weight: bold;" text="Logout" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>
            </HBox>
        </VBox>
    </AnchorPane>
</StackPane>
