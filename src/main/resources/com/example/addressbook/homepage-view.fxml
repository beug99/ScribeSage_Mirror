<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="472.0" prefWidth="811.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.addressbook.controller.HomePageController">
    <HBox>
        <ImageView fitHeight="57.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../../../Images/UserIcon.png" />
            </image></ImageView>
        <Label contentDisplay="BOTTOM" prefHeight="39.0" prefWidth="190.0" text="First and last name">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
    </HBox>
    <HBox>
        <Label text="Notes" />
    </HBox>
    <HBox>
        <Button fx:id="logOut" onAction="#onLogOut" text="Log Out" />
    </HBox>
    <HBox>
        <Button fx:id="updatePassword" onAction="#onUpdatePassword" text="Update Password" />
    </HBox>
</VBox>
