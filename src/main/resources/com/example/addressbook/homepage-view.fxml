<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.addressbook.controller.HomePageController">

    <!-- AnchorPane to manage top-level layout -->
    <AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: white;">

        <!-- Profile bar (at the top) -->
        <HBox fx:id="profileBar" alignment="CENTER_LEFT" onMouseClicked="#toggleNavMenu" spacing="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="10.0">
            <ImageView fitHeight="49.0" fitWidth="53.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../../../Images/Icon%20purple.png" />
                </image>
            </ImageView>
            <Label fx:id="nameLabel" text="First and last name">
                <font>
                    <Font name="System Bold" size="16.0" />
                </font>
            </Label>
        </HBox>

        <!-- Main layout (notes list and buttons) -->
        <VBox fx:id="mainLayout" alignment="TOP_CENTER" prefHeight="400.0" prefWidth="900.0" spacing="20.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="120.0">
            <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Your Notes:" />

            <!-- ⬇ Replace ListView with this -->
            <HBox alignment="CENTER">
                <ListView fx:id="notesListView" maxWidth="650.0" prefHeight="300.0" prefWidth="650.0" style="-fx-border-color: #6a5acd;" VBox.vgrow="ALWAYS" />
            </HBox>

            <HBox alignment="CENTER" spacing="20.0">
                <Button fx:id="deleteNoteButton" onAction="#onDeleteNote" prefWidth="120.0" style="-fx-background-color: #6a5acd; -fx-text-fill: white; -fx-font-weight: bold;" text="Delete Selected" />
                <Button fx:id="createNewButton" onAction="#onCreateNew" style="-fx-background-color: #6a5acd; -fx-text-fill: white; -fx-font-weight: bold;" text="Create New" />
                <Button fx:id="loadNoteButton" onAction="#onLoadNote" prefWidth="120.0" style="-fx-background-color: #6a5acd; -fx-text-fill: white; -fx-font-weight: bold;" text="Load Selected" />
            </HBox>
        </VBox>

        <!-- Nav menu that drops down below the profile bar -->
        <VBox fx:id="navMenu" prefHeight="166.0" prefWidth="188.0" style="-fx-background-color: white; -fx-border-color: lightgray; -fx-effect: dropshadow(gaussian, lightgray, 8, 0, 2, 2);" stylesheets="@../../../css/navmenu.css" visible="false" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="60.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="nav-item">
                    <ImageView fitHeight="32.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../../../Images/Update%20Details%20purple.png" />
                        </image>
                    </ImageView>
                    <Label fx:id="updateDetailsLabel" onMouseClicked="#onUpdateDetails" style="-fx-cursor: hand;" text="Update Details">
                        <font><Font name="System Bold" size="12.0" /></font>
                    </Label>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="nav-item">
                    <ImageView fitHeight="28.0" fitWidth="33.0" pickOnBounds="true" preserveRatio="true">
                        <image><Image url="@../../../Images/Settings%20purple.png" /></image>
                    </ImageView>
                    <Label prefHeight="18.0" prefWidth="114.0" text="Settings">
                        <font><Font name="System Bold" size="12.0" /></font>
                    </Label>
                </HBox>
                <HBox alignment="CENTER_LEFT" onMouseClicked="#onLogOut" spacing="10.0" styleClass="nav-item">
                    <ImageView fitHeight="31.0" fitWidth="34.0" pickOnBounds="true" preserveRatio="true">
                        <image><Image url="@../../../Images/Log%20out%20purple.png" /></image>
                    </ImageView>
                    <Label prefHeight="18.0" prefWidth="152.0" text="Logout">
                        <font><Font name="System Bold" size="12.0" /></font>
                    </Label>
                </HBox>
            </children>
        </VBox>
    </AnchorPane>
</StackPane>
