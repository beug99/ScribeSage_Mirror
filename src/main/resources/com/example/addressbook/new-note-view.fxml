<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.web.*?>

<AnchorPane id="rootBox" style="-fx-background-color: #2a2d3e;" stylesheets="@../../../css/newnote.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.addressbook.controller.NewNoteController">

    <VBox maxHeight="-Infinity" minHeight="-Infinity" prefHeight="780.0" style="-fx-background-color: #2a2d3e;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <!-- Header Section -->
        <VBox style="-fx-background-color: #2a2d3e;">
            <GridPane fx:id="profileBar" style="-fx-background-color: #2a2d3e;">
                <columnConstraints>
                    <ColumnConstraints minWidth="50.0" />
                    <ColumnConstraints hgrow="ALWAYS" />
                    <ColumnConstraints minWidth="80.0" />
                </columnConstraints>
                <padding>
                    <Insets bottom="10.0" left="20.0" right="20" top="10.0" />
                </padding>
                <ImageView fitHeight="41.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true" GridPane.columnIndex="0">
                    <image>
                        <Image url="@../../../Images/logo kinda purple.jpeg" />
                    </image>
                </ImageView>
                <Label fx:id="nameLabel" contentDisplay="BOTTOM" prefHeight="42.0" prefWidth="366.0" text="First and last name" textFill="WHITE" GridPane.columnIndex="1">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Button fx:id="homeButton" onAction="#onHomeButtonClick" prefWidth="80" style="-fx-background-color: #6a5acd;" text="Home" textFill="WHITE" GridPane.columnIndex="2">
               <font>
                  <Font name="HelveticaRounded-Bold" size="12.0" />
               </font></Button>
                <rowConstraints>
                    <RowConstraints />
                </rowConstraints>
            </GridPane>

            <HBox>
                <padding>
                    <Insets left="20" right="20" />
                </padding>
            </HBox>
        </VBox>

        <!-- Main Content Section -->
        <VBox style="-fx-background-color: #2a2d3e;" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="25.0" />
            </padding>

            <!-- NOTE NAME - SEARCH BUTTON AND SEARCH BAR -->
            <VBox id="names" spacing="10" style="-fx-background-color: #2a2d3e;" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Title:   " textFill="WHITE" GridPane.vgrow="NEVER" />
                    <Label fx:id="currentNoteName" text="Name Filled When Note Made" textFill="WHITE" />

            </VBox>
            <HBox alignment="CENTER" maxHeight="35" style="-fx-background-radius: 3; -fx-background-color: #6a5acd;">
                <TextField fx:id="searchBarID" prefHeight="25" prefWidth="-Infinity" promptText="Search Note" HBox.hgrow="ALWAYS">
               <font>
                  <Font name="Helvetica" size="12.0" />
               </font></TextField>
                <Button fx:id="searchBarButton" onAction="#searchBarButtonClick" style="-fx-background-color: #6a5acd; -fx-background-radius: 3;" text="Search">
               <font>
                  <Font name="HelveticaRounded-Bold" size="12.0" />
               </font></Button>
            </HBox>
            <!-- SAVE BUTTONS - AI BUTTONS -->
            <HBox spacing="10">
                <padding>
                    <Insets bottom="10" top="25" />
                </padding>
                <Button fx:id="saveButton" onAction="#onSaveButtonClick" style="-fx-background-color: #6a5acd;" text="Save Note" textFill="WHITE">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>
                <Button fx:id="importAudioButton" onAction="#onLoadButtonClick" style="-fx-background-color: #6a5acd;" text="Import Audio" textFill="WHITE">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>

                <!-- Added StackPane to overlay progress indicator on button -->
                <StackPane>
                    <Button fx:id="enhanceTextButton" onAction="#onEnhanceButton" style="-fx-background-color: #6a5acd;" text="Enhance Selected Text" textFill="WHITE">
                        <font>
                            <Font size="14.0" />
                        </font>
                    </Button>
                    <ProgressIndicator fx:id="enhanceProgress" maxHeight="20" maxWidth="20" visible="false" />
                </StackPane>

                <!-- Added StackPane to overlay progress indicator on button -->
                <StackPane>
                    <Button fx:id="summariseTextButton" onAction="#onSummariseButton" style="-fx-background-color: #6a5acd;" text="Summarise Selected Text" textFill="WHITE">
                        <font>
                            <Font size="14.0" />
                        </font>
                    </Button>
                    <ProgressIndicator fx:id="summariseProgress" maxHeight="20" maxWidth="20" visible="false" />
                </StackPane>

            </HBox>
            <!-- HTML EDITOR - Set to grow within available space -->
            <AnchorPane style="-fx-background-color: #2a2d3e;" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets bottom="15" top="15" />
                </padding>
                <HTMLEditor fx:id="htmlEditorGui" htmlText="&lt;html&gt;&lt;body style='margin:0;padding:5px;height:100%;background-color:white;'&gt;&lt;p&gt;Start writing your note here...&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;" style="-fx-background-color: white;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
            </AnchorPane>
        </VBox>
    </VBox>
</AnchorPane>
