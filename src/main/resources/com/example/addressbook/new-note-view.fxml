<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.web.*?>

<AnchorPane stylesheets="@../../../css/newnote.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.addressbook.controller.NewNoteController">
    <VBox>
    <VBox>
        <GridPane fx:id="profileBar" onMouseClicked="#toggleNavMenu">
            <columnConstraints>
                <ColumnConstraints minWidth="0.0" />
                <ColumnConstraints hgrow="ALWAYS" />
                <ColumnConstraints />
            </columnConstraints>
            <padding>
                <Insets bottom="10.0" left="10.0" top="10.0" right="20"/>
            </padding>
            <ImageView fitHeight="41.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true" GridPane.columnIndex="0">
                <image>
                    <Image url="@../../../Images/UserIcon.png" />
                </image>
            </ImageView>
            <Label fx:id="nameLabel" contentDisplay="BOTTOM" prefHeight="42.0" prefWidth="143.0" text="First and last name" GridPane.columnIndex="1">            <font>
                <Font name="System Bold" size="16.0" />
            </font>
            </Label>
            <Button fx:id="homeButton" onAction="#onHomeButtonClick" prefWidth="80" text="Home"  GridPane.columnIndex="2"/>

        </GridPane>

        <HBox>
            <padding>
                <Insets left="20" right="20"/>
            </padding>
            <Line endX="800" fill="#4D4B4B" stroke="#777676" strokeWidth="2.5" />
        </HBox>

    </VBox>

    <VBox>
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="25.0" />
        </padding>

<!--        NOTE NAME - SEARCH BUTTON AND SEARCH BAR-->
        <GridPane hgap="0" vgap="15.0">
            <columnConstraints>
                <ColumnConstraints minWidth="0.0" />
                <ColumnConstraints hgrow="ALWAYS" />
                <ColumnConstraints />
            </columnConstraints>

            <HBox id="names" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="Name:   " GridPane.vgrow="NEVER" />
                <Label fx:id="currentNoteName" text="Name Filled When Note Made" />
            </HBox>

            <HBox GridPane.columnIndex="1" alignment="TOP_RIGHT" spacing="10">
                <TextField fx:id="searchBarID" promptText="Search Note" maxWidth="400" />
                <Button fx:id="searchBarButton" onAction="#searchBarButtonClick" text="Search" prefWidth="80" />
            </HBox>

        </GridPane>

<!--        SAVE BUTTONS - AI BUTTONS-->
        <HBox spacing="10">
            <padding>
                <Insets bottom="10" top="25" />
            </padding>
            <Button fx:id="saveButton" onAction="#onSaveButtonClick" text="Save Note" />
            <Button fx:id="loadButton" onAction="#onLoadButtonClick" text="Load" />
            <Button fx:id="cancelButton" onAction="#onCancelButtonClick" text="Cancel" />

            <!-- Added StackPane to overlay progress indicator on button -->
            <StackPane>
                <Button fx:id="enhanceTextButton" onAction="#onEnhanceButton" text="Enhance Selected Text" />
                <ProgressIndicator fx:id="progressIndicator" maxHeight="20" maxWidth="20" visible="false" />
            </StackPane>

            <Button fx:id="getHighlightedButton" onAction="#onGetHighlighted" text="Show Selected" />
        </HBox>

        <VBox fx:id="vBoxForHtmlGui" alignment="CENTER" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="15" top="15" />
            </padding>
            <HTMLEditor fx:id="htmlEditorGui" htmlText="&lt;html&gt;&lt;body&gt;&lt;p&gt;Start writing your note here...&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;" prefHeight="400" />
        </VBox>
    </VBox>
    </VBox>
</AnchorPane>
