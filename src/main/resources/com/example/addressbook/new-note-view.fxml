<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.addressbook.controller.NewNoteController">

    <VBox alignment="CENTER" spacing = "10.0" AnchorPane.topAnchor="10.0" AnchorPane.bottomAnchor="10.0"
          AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="0.0">

        <padding>
            <Insets bottom="20.0" right="20.0" />
        </padding>
        <Label text="This is the heading section - label, search bar etc" />
        <HBox>
            <Label text="This is where the font/size/colour etc goes" />
        </HBox>
        <HBox>
            <TextArea fx:id="noteTextField">

            </TextArea>
        </HBox>



    </VBox>


</AnchorPane>
