<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.addressbook.controller.LoginController">
    <VBox alignment="CENTER" spacing="15.0" AnchorPane.topAnchor="20.0" AnchorPane.bottomAnchor="20.0"
          AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">

        <!-- support contact link could go here? -->

        <Label text="ScribeSage" textFill="#0099ff">
            <font>
                <Font name="Arial Bold" size="28"/>
            </font>
        </Label>

        <!-- email -->
        <VBox spacing="5.0">
            <Label text="Email Address:" textFill="#0099ff"/>
            <TextField fx:id="eMail" promptText="Enter email address..."/>
        </VBox>

        <!-- password -->
        <VBox spacing="5.0">
            <Label text="Password:" textFill="#0099ff"/>
            <PasswordField fx:id="password" promptText="Enter password..."/>
        </VBox>

        <!-- log in -->
        <Button text="Log In" fx:id="logIn" prefWidth="200" style="-fx-background-color: #0099ff;
        -fx-text-fill: white; -fx-font-weight: bold;" onAction="#onLogIn"/>

        <!-- sign up button -->
        <Label text="Don't have an account?"/>
        <Button text="Sign up" onAction="#onSignUp" fx:id="signUp" prefWidth="200" style="-fx-background-color: #0099ff;
        -fx-text-fill: white; -fx-font-weight: bold;"/>

    </VBox>
</AnchorPane>