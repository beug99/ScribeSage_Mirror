<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox fx:id="layout" spacing="10" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.addressbook.controller.TranscriptionPopupController">
   <padding>
      <Insets top="10" right="10" bottom="10" left="10"/>
   </padding>

   <Button fx:id="chooseFileButton" text="Choose audio file" onAction="#onChooseFile"/>
   <TextArea fx:id="transcriptArea" wrapText="true" editable="false"/>
   <Button fx:id="copyButton" text="Copy Transcript" onAction="#onCopyTranscript"/>
</VBox>
